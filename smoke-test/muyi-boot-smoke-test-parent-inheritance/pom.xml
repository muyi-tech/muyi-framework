<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 方式一：继承 muyi-boot-parent（推荐业务应用）
         自动获得：BOM 依赖版本管理 + 构建规范（Java 21 / 格式校验 / 环境约束）+ 统一测试依赖 -->
    <parent>
        <groupId>io.github.muyi-tech.boot</groupId>
        <artifactId>muyi-boot-parent</artifactId>
        <version>1.0.1-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>com.example.muyi</groupId>
    <artifactId>muyi-boot-smoke-test-parent-inheritance</artifactId>
    <version>1.0.1-SNAPSHOT</version>
    <name>Muyi Boot Smoke Test - Parent Inheritance</name>
    <description>示例一：继承 muyi-boot-parent 接入 Muyi Framework（推荐业务应用方式）</description>

    <dependencies>
        <!-- WebMVC 起步依赖（版本由 parent 继承的 BOM 统一管理）：
             一个坐标聚合官方 webmvc + validation starter 与 muyi-boot-webmvc 异常处理模块 -->
        <dependency>
            <groupId>io.github.muyi-tech.boot</groupId>
            <artifactId>muyi-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- 测试：聚合官方 starter-test 与 Boot 4 拆分的 spring-boot-starter-webmvc-test -->
        <dependency>
            <groupId>io.github.muyi-tech.boot</groupId>
            <artifactId>muyi-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 框架当前为 1.0.1-SNAPSHOT，需配置 Central 快照仓库；正式版发布后移除本段即可 -->
    <repositories>
        <repository>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <!-- 可执行 jar 打包；版本由 parent 的 pluginManagement 统一提供 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
